# Example NGINX reverse proxy configuration
# Replace placeholders before using this configuration.

location /api/ {
    proxy_pass https://YOUR_API_ID.execute-api.eu-north-1.amazonaws.com/;

    proxy_ssl_server_name on;
    proxy_set_header Host YOUR_API_ID.execute-api.eu-north-1.amazonaws.com;

    proxy_set_header X-Environment "dev";
    proxy_set_header X-Student-ID "YOUR_STUDENT_ID";
    proxy_set_header X-Internal-Token "YOUR_INTERNAL_TOKEN";

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
