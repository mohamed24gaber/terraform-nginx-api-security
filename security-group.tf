resource "aws_security_group" "nginx_api_security" {
  name        = "nginx-api-security-sg"
  description = "Security group for NGINX API Gateway assignment"
  vpc_id      = "vpc-0f239b83f804cacaf"

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.ssh_allowed_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
